{
  "name": "react-resize-bounding",
  "description": "React highly customizable component for resizing nested content",
  "version": "1.1.3",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "yamogoo",
    "email": "grebennikovmisha@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:yamogoo/resize-bounding.git"
  },
  "type": "module",
  "keywords": [
    "react",
    "resizer",
    "react resizer",
    "resize",
    "bounding box",
    "resize bounding",
    "resize container",
    "draggable container"
  ],
  "main": "dist/react-resize-bounding.umd.js",
  "module": "dist/react-resize-bounding.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-resize-bounding.es.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/react-resize-bounding.cjs.js"
    }
  },
  "files": [
    "dist/*",
    "lib/*"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "docs:dev": "storybook dev -p 6008",
    "docs:build": "storybook build",
    "docs:preview": "pnpm storybook:build && serve storybook-static -p 6009",
    "deploy:docs:dev": "netlify build && netlify deploy",
    "deploy:docs:prod": "pnpm docs:build && netlify build && netlify deploy --prod"
  },
  "peerDependencies": {
    "react": "16.8.0 || 17.x",
    "react-dom": "16.8.0 || 17.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@storybook/theming": "^8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@tsconfig/node20": "^20.1.9",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "netlify-cli": "^24.2.0",
    "prettier": "^3.8.1",
    "storybook": "^9.1.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fluentui/merge-styles": "^8.6.14",
    "deepmerge": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
