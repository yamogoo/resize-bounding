{
  "name": "react-resize-bounding",
  "description": "React highly customizable component for resizing nested content",
  "version": "1.1.0",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "yamogoo",
    "email": "grebennikovmisha@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:yamogoo/resize-bounding.git"
  },
  "type": "module",
  "keywords": [
    "react",
    "resizer",
    "react resizer",
    "resize",
    "bounding box",
    "resize bounding",
    "resize container",
    "draggable container"
  ],
  "main": "dist/react-resize-bounding.umd.js",
  "module": "dist/react-resize-bounding.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/react-resize-bounding.es.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/react-resize-bounding.cjs.js"
    }
  },
  "files": [
    "dist/*",
    "lib/*"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "docs:dev": "storybook dev -p 6008",
    "docs:build": "storybook build",
    "docs:preview": "pnpm storybook:build && serve storybook-static -p 6009",
    "deploy:docs:dev": "netlify build && netlify deploy",
    "deploy:docs:prod": "pnpm docs:build && netlify build && netlify deploy --prod"
  },
  "peerDependencies": {
    "react": "16.8.0 || 17.x",
    "react-dom": "16.8.0 || 17.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/preview-api": "^8.6.14",
    "@storybook/react": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@storybook/theming": "^8.6.14",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.52",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.0.0",
    "globals": "^16.2.0",
    "jsdom": "^24.1.3",
    "netlify-cli": "^21.5.0",
    "prettier": "^3.5.3",
    "storybook": "^9.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fluentui/merge-styles": "^8.6.14",
    "deepmerge": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
