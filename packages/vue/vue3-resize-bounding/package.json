{
  "name": "vue3-resize-bounding",
  "description": "Vue3 highly customizable component for resizing nested content",
  "version": "2.1.3",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "yamogoo",
    "email": "grebennikovmisha@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:yamogoo/resize-bounding.git"
  },
  "type": "module",
  "keywords": [
    "vue3",
    "resizer",
    "vue3 resizer",
    "resize",
    "bounding box",
    "resize bounding",
    "resize container",
    "draggable container"
  ],
  "main": "dist/vue3-resize-bounding.umd.js",
  "module": "dist/vue3-resize-bounding.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue3-resize-bounding.es.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/vue3-resize-bounding.cjs.js"
    }
  },
  "files": [
    "dist/*",
    "lib/*"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs'); for (const file of ['README.md.back','package.json.back']) fs.rmSync(file, { force: true });\"",
    "build": "pnpm lint && tsc -b tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test:unit": "vitest",
    "test:ui": "vitest --ui",
    "docs:dev": "storybook dev -p 6006",
    "docs:build": "storybook build",
    "docs:preview": "pnpm docs:build && serve storybook-static -p 6007",
    "deploy:docs:dev": "netlify build && netlify deploy",
    "deploy:docs:prod": "pnpm docs:build && netlify build && netlify deploy --prod"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/test": "^8.6.15",
    "@storybook/theming": "^8.6.14",
    "@storybook/vue3": "^8.6.17",
    "@storybook/vue3-vite": "^8.6.17",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.33",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.5.0",
    "jsdom": "^24.1.3",
    "netlify-cli": "^20.1.1",
    "sass": "^1.97.3",
    "serve": "^14.2.5",
    "storybook": "^8.6.17",
    "terser": "^5.46.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@fluentui/merge-styles": "^8.6.14",
    "deepmerge": "^4.3.1",
    "vue": "^3.5.28"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
