{
  "name": "vue3-resize-bounding",
  "description": "Vue3 highly customizable component for resizing nested content",
  "version": "2.0.6",
  "license": "MIT",
  "private": false,
  "author": {
    "name": "yamogoo",
    "email": "grebennikovmisha@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:yamogoo/resize-bounding.git"
  },
  "type": "module",
  "keywords": [
    "vue3",
    "resizer",
    "vue3 resizer",
    "resize",
    "bounding box",
    "resize bounding",
    "resize container",
    "draggable container"
  ],
  "main": "dist/vue3-resize-bounding.umd.js",
  "module": "dist/vue3-resize-bounding.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue3-resize-bounding.es.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/vue3-resize-bounding.cjs.js"
    }
  },
  "files": [
    "dist/*",
    "lib/*"
  ],
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "build": "pnpm lint && tsc -b tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "test:unit": "vitest",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "vue": "^3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.24",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "sass": "^1.85.1",
    "terser": "^5.39.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^5.4.15",
    "vite-plugin-dts": "^3.9.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.8"
  },
  "dependencies": {
    "@fluentui/merge-styles": "^8.6.14",
    "deepmerge": "^4.3.1",
    "vue": "^3.5.13"
  }
}
